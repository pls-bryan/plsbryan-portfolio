<!DOCTYPE html>
<html lang="en" class="clock-page">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual Clock</title>
    <link rel="stylesheet" href="styles.css">
    <link rel="icon" type="image/svg" href="graphics/pls_logo_white.png" />
    <!-- Link Swiper's CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            
            width: 100%;
            height: 100%;
        }
        canvas {
            display: block;
            position: fixed;
            top: 0;
            left: 0;
        }
        .clock-page main {
            padding-top: 0;
        }
    </style>
   
    <script is:inline src="/p5.min.js"></script>
    <script is:inline src="/clock.js"></script>
</head>
